{
  "name": "hebei-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node server/server.js",
    "start": "node server/server.js",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "admin:reset-password": "node server/resetAdminPassword.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "test:api": "node --test test/api-workflow.test.js"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "mysql2": "^3.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "^5.4.21"
  }
}
